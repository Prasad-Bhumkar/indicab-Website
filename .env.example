# ============================================================
# IndiCab Docker Environment Configuration
# ============================================================
# Copy this file to .env and update values for your environment

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_ROOT_PASSWORD=root_password
DB_NAME=indicab_website
DB_USERNAME=indicab_user
DB_PASSWORD=indicab_password
DB_PORT=3306

# ============================================================
# BACKEND CONFIGURATION (Spring Boot)
# ============================================================
BACKEND_PORT=8000

# JWT Configuration (Security)
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# JPA/Hibernate Configuration
JPA_DDL_AUTO=update

# Application Profile
SPRING_PROFILE=dev

# CORS Configuration (Allowed Origins for Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ============================================================
# FRONTEND CONFIGURATION (React/Vite)
# ============================================================
FRONTEND_PORT=80

# API URL for Frontend to communicate with Backend
VITE_API_URL=http://localhost:8000/api/v1

# ============================================================
# PRODUCTION OVERRIDES
# ============================================================
# For production deployment, override with:
# SPRING_PROFILE=prod
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# VITE_API_URL=https://yourdomain.com/api/v1
# JWT_SECRET=use-a-strong-random-secret-key
