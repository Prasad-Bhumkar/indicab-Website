# ============================================================================
# IndiCab Production Environment Configuration
# ============================================================================
# This file contains all required environment variables for production deployment
# Copy this to .env and update values for your deployment
# ============================================================================

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Backend API Base URL
VITE_API_BASE_URL=https://api.indicab.com

# Application Name
VITE_APP_NAME=IndiCab

# Logging Level (debug, info, warn, error)
VITE_LOG_LEVEL=warn

# Debug Mode (true/false) - MUST be false in production
VITE_DEBUG_MODE=false

# Analytics Collection (true/false)
VITE_ENABLE_ANALYTICS=true

# Sentry Error Tracking
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACE_SAMPLE_RATE=0.1

# ============================================================================
# BACKEND CONFIGURATION - Database
# ============================================================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your-secure-root-password
MYSQL_DATABASE=indicab_website
MYSQL_USER=indicab_user
MYSQL_PASSWORD=your-secure-mysql-password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Spring DataSource
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/indicab_website?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
SPRING_DATASOURCE_USERNAME=indicab_user
SPRING_DATASOURCE_PASSWORD=your-secure-mysql-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Hibernate/JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Flyway Database Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
SPRING_FLYWAY_OUT_OF_ORDER=false

# ============================================================================
# BACKEND CONFIGURATION - Redis
# ============================================================================

# Redis Cache Configuration
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your-secure-redis-password
SPRING_REDIS_TIMEOUT=60000ms
REDIS_CACHE_TTL=3600

# ============================================================================
# BACKEND CONFIGURATION - Authentication & Security
# ============================================================================

# JWT Token Configuration
JWT_SECRET=your-very-secure-jwt-secret-key-min-32-chars-long
JWT_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://indicab.com,https://www.indicab.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# BACKEND CONFIGURATION - Application
# ============================================================================

# Application Server Configuration
SERVER_PORT=8000
SERVER_SERVLET_CONTEXT_PATH=/
SPRING_PROFILES_ACTIVE=production

# Application Name & Version
SPRING_APPLICATION_NAME=indicab-backend
APP_VERSION=1.0.0

# ============================================================================
# BACKEND CONFIGURATION - Logging
# ============================================================================

# Logging Configuration
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_INDICAB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=WARN
LOGGING_FILE_NAME=/var/log/indicab/application.log
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_MAX_HISTORY=30

# ============================================================================
# BACKEND CONFIGURATION - Health & Monitoring
# ============================================================================

# Spring Boot Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_HEALTH_LIVENESSSTATE_ENABLED=true
MANAGEMENT_HEALTH_READINESSSTATE_ENABLED=true
MANAGEMENT_ENDPOINTS_WEB_BASE_PATH=/actuator

# ============================================================================
# BACKEND CONFIGURATION - External Services
# ============================================================================

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/backend-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email Configuration (Optional - for future use)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=your-email@gmail.com
MAIL_SMTP_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=noreply@indicab.com

# ============================================================================
# DOCKER COMPOSE DEPLOYMENT CONFIGURATION
# ============================================================================

# Docker Compose Environment
COMPOSE_PROJECT_NAME=indicab
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Service Replicas
BACKEND_REPLICAS=1
FRONTEND_REPLICAS=1

# ============================================================================
# NGINX REVERSE PROXY CONFIGURATION
# ============================================================================

# Let's Encrypt SSL Configuration
LETSENCRYPT_EMAIL=admin@indicab.com
DOMAIN_NAME=indicab.com
DOMAIN_WILDCARD=*.indicab.com

# Nginx Settings
NGINX_WORKER_CONNECTIONS=4096
NGINX_CLIENT_MAX_BODY_SIZE=100M

# Rate Limiting
NGINX_RATE_LIMIT_API=100r/s
NGINX_RATE_LIMIT_AUTH=10r/m

# ============================================================================
# BACKUP & MAINTENANCE CONFIGURATION
# ============================================================================

# Database Backup
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/backups

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================
# 1. Replace all "your-*" placeholders with actual values
# 2. For JWT_SECRET, use: openssl rand -base64 32
# 3. For Redis password, use: openssl rand -base64 32
# 4. For MySQL passwords, use: openssl rand -base64 32
# 5. Ensure SSL certificates are in ./ssl/ directory
# 6. Test locally with docker-compose before deploying to VPS
# 7. Never commit actual secrets to git - use vault/CI-CD secrets management
# 8. Rotate secrets regularly in production
# ============================================================================
