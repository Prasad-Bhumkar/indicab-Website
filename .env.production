# ============================================================================
# IndiCab Production Docker Environment Configuration
# ============================================================================
# For production deployment - UPDATE ALL VALUES BEFORE DEPLOYING!

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Backend API Base URL - UPDATE THIS!
VITE_API_BASE_URL=https://api.yourdomain.com

# Application Name
VITE_APP_NAME=IndiCab
VITE_APP_VERSION=1.0.0

# Logging Level (keep minimal in production)
VITE_LOG_LEVEL=warn
VITE_DEBUG_MODE=false

# Analytics
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_DRIVER_MODE=true
VITE_ENABLE_ADMIN_PANEL=true

# Sentry Error Tracking - UPDATE THIS!
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACE_SAMPLE_RATE=0.1

# ============================================================================
# BACKEND CONFIGURATION - Database
# ============================================================================

# MySQL Database Configuration - GENERATE STRONG PASSWORDS!
# Command: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=your-secure-root-password-32-chars
MYSQL_DATABASE=indicab_website
MYSQL_USER=indicab_user
MYSQL_PASSWORD=your-secure-mysql-password-32-chars
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Spring DataSource Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/indicab_website?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
SPRING_DATASOURCE_USERNAME=indicab_user
SPRING_DATASOURCE_PASSWORD=your-secure-mysql-password-32-chars
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Hibernate/JPA Configuration (validate in production with Flyway)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Flyway Database Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
SPRING_FLYWAY_OUT_OF_ORDER=false

# ============================================================================
# BACKEND CONFIGURATION - Redis
# ============================================================================

# Redis Cache Configuration
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your-secure-redis-password-32-chars
SPRING_REDIS_TIMEOUT=60000ms
REDIS_ENABLED=true
REDIS_CACHE_TTL=3600

# ============================================================================
# BACKEND CONFIGURATION - Authentication & Security
# ============================================================================

# JWT Token Configuration - GENERATE STRONG SECRET!
# Command: openssl rand -base64 32
JWT_SECRET=kf&JsR9mK2nP7vL4xQ8wT3bG6hA1cD5eF9iU2jO0lM4sN7rP3vE6wY8zB1qD4sF7gH9jK2lN5oP3rS6tU8vW1xY4zA2cD5eF8gH1jK4lM7nO0pQ3rS6tU9vW2xY5zB
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# CORS Configuration - UPDATE FOR YOUR DOMAIN!
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ============================================================================
# BACKEND CONFIGURATION - Server & Application
# ============================================================================

# Application Server Configuration
SERVER_PORT=8000
SERVER_SERVLET_CONTEXT_PATH=/
SPRING_PROFILES_ACTIVE=production
SPRING_APPLICATION_NAME=indicab-backend
APP_VERSION=1.0.0

# HikariCP Connection Pool (tuned for production)
DB_POOL_SIZE=20
DB_MIN_IDLE=10

# Error Handling
ERROR_STACKTRACE=never

# ============================================================================
# BACKEND CONFIGURATION - Logging
# ============================================================================

# Logging Configuration (minimal in production)
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_INDICAB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN

# Logging File
LOGGING_FILE_NAME=/var/log/indicab/application.log
LOGGING_FILE_MAX_SIZE=100MB
LOGGING_FILE_MAX_HISTORY=30

# ============================================================================
# BACKEND CONFIGURATION - Health & Monitoring
# ============================================================================

# Spring Boot Actuator (limited endpoints in production)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_HEALTH_LIVENESSSTATE_ENABLED=true
MANAGEMENT_HEALTH_READINESSSTATE_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
MANAGEMENT_ENDPOINTS_WEB_BASE_PATH=/actuator

# ============================================================================
# BACKEND CONFIGURATION - External Services
# ============================================================================

# Sentry Error Tracking - UPDATE THIS!
SENTRY_DSN=https://your-sentry-dsn@sentry.io/backend-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email Configuration - UPDATE WITH REAL CREDENTIALS!
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=your-email@gmail.com
MAIL_SMTP_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=noreply@yourdomain.com

# ============================================================================
# DOCKER COMPOSE CONFIGURATION
# ============================================================================

# Project Name
COMPOSE_PROJECT_NAME=indicab

# Docker Build Settings
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Service Configurations
BACKEND_PORT=8000
FRONTEND_PORT=80
MYSQL_PORT=3306
REDIS_PORT=6379

# ============================================================================
# NGINX REVERSE PROXY CONFIGURATION
# ============================================================================

# Domain Configuration - UPDATE THIS!
DOMAIN_NAME=yourdomain.com
DOMAIN_WILDCARD=*.yourdomain.com

# Nginx Settings
NGINX_WORKER_CONNECTIONS=4096
NGINX_CLIENT_MAX_BODY_SIZE=100M

# Rate Limiting
NGINX_RATE_LIMIT_API=100r/s
NGINX_RATE_LIMIT_AUTH=10r/m

# SSL Certificate (Let's Encrypt)
LETSENCRYPT_EMAIL=admin@yourdomain.com

# ============================================================================
# BACKUP & MAINTENANCE CONFIGURATION
# ============================================================================

# Database Backup (daily at 2 AM)
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/backups

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# BEFORE DEPLOYING, COMPLETE THESE STEPS:
#
# 1. Generate secure passwords:
#    - MYSQL_ROOT_PASSWORD: openssl rand -base64 32
#    - MYSQL_PASSWORD: openssl rand -base64 32
#    - SPRING_REDIS_PASSWORD: openssl rand -base64 32
#    - JWT_SECRET: openssl rand -base64 32
#
# 2. Update domain/email values:
#    - DOMAIN_NAME
#    - DOMAIN_WILDCARD
#    - LETSENCRYPT_EMAIL
#    - VITE_API_BASE_URL
#    - CORS_ALLOWED_ORIGINS
#
# 3. Setup email service:
#    - MAIL_SMTP_USERNAME (actual email)
#    - MAIL_SMTP_PASSWORD (app password, NOT account password)
#    - MAIL_FROM
#
# 4. Configure error tracking (Sentry):
#    - VITE_SENTRY_DSN
#    - SENTRY_DSN
#
# 5. Store this file securely:
#    - Use CI/CD secrets management
#    - Never commit to git
#    - Use environment variable management service
#
# 6. Test locally with:
#    docker-compose -f docker-compose.prod.yml up
#
# 7. Verify all services running:
#    docker-compose ps
#
# 8. Test endpoints:
#    - Frontend: https://yourdomain.com
#    - API Docs: https://yourdomain.com/api/v1/swagger-ui.html
#    - Health: https://yourdomain.com/actuator/health
#
# ============================================================================
