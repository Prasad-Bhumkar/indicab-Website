{
  "scripts": {
    "dev:all": "cd indicab-frontend && npm run dev -- --port 5174",
    "dev:all:mac": "cd indicab-frontend && npm run dev -- --port 5174",
    "agent:auth": "npx --yes @builder.io/agent auth --local --json -c --acceptSelfSigned",
    "agent:launch": "npx --yes @builder.io/agent launch --local --json -c \"docker compose up\" --acceptSelfSigned",
    "builder": "npm run agent:auth && npm run agent:launch"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
